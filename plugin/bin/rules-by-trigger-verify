#!/bin/sh
# rules-by-trigger Stop verification launcher. A dedicated entry point instead of
# passing --verify as an argument: the hook config then needs no `args` array,
# which older Claude Code builds ignore silently. ALWAYS exits 0, like every
# other launcher here, and that is not in tension with holding the turn open:
# a failed verification blocks through the JSON it prints on stdout
# ({"decision": "block"}), never through an exit code.
SELF=$0
while [ -L "$SELF" ]; do
    LINK=$(readlink "$SELF")
    case $LINK in /*) SELF=$LINK ;; *) SELF=$(dirname -- "$SELF")/$LINK ;; esac
done
DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")/.." && pwd) || exit 0
# See bin/rules-by-trigger for why `py` is in this list and why each candidate has
# to prove it runs before being used.
for PY in python3 python py; do
    command -v "$PY" >/dev/null 2>&1 || continue
    if [ "$PY" = "py" ]; then PYARGS="-3"; else PYARGS=""; fi
    "$PY" $PYARGS -c "" >/dev/null 2>&1 || continue
    # Run rather than exec, then exit 0: consistent with the PreToolUse
    # launcher, a missing script must never surface as a non-zero exit.
    "$PY" $PYARGS "$DIR/hooks/rules-by-trigger.py" --verify
    exit 0
done
exit 0
